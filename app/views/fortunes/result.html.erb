<div class="page-container">
  <div class="diagnosis-card">
    <h1 class="page-title">診断結果</h1>

    <div class="loading-text" id="loading-text">
      診断中...
    </div>

    <p class="fortune-text hidden <%= 'rare' if @fortune.rare? %>" id="fortune-text">
      <%= @fortune.content %>
    </p>

    <% if @fortune.rare? %>
      <div class="rare-badge hidden" id="rare-badge">RARE</div>
    <% end %>

    <% share_text = "ひとこと診断の結果：#{@fortune.content}" %>

    <div class="action-links hidden" id="action-links">
      <%= link_to "Xでシェアする",
                  "https://twitter.com/intent/tweet?text=#{ERB::Util.url_encode(share_text)}",
                  target: "_blank",
                  rel: "noopener",
                  class: "sub-link" %>

      <%= link_to "トップに戻る", root_path, class: "sub-link" %>
    </div>
  </div>
</div>